# Copy file nay thanh .env roi dien gia tri that:  copy .env.example .env

# --- LLM: Gemini (OpenAI-compatible API) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=3072

# --- Qdrant ---
# Qdrant chay bang Docker (docker compose up -d qdrant). De trong = chay local khong can Docker.
QDRANT_URL=http://localhost:6333
COLLECTION=docs

# --- Tuy chon: ghi de so tinh chinh trong app/config.py ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# CHUNK_MODE=sentence
# TOP_K=8
# MAX_RETRIES=5
